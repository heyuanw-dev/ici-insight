# Phase 1 runs without credentials. These values prepare later integrations.
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Vancouver

# Populate when connecting Supabase in Phase 2.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only; never prefix this with NEXT_PUBLIC_. Not used by Phase 1.
SUPABASE_SECRET_KEY=

# File handling is deferred to Phase 6; no buckets are created in Phase 1.
SUPABASE_PPTX_BUCKET=presentation-originals
SUPABASE_PDF_BUCKET=presentation-previews
MAX_UPLOAD_BYTES=50000000
FILE_URL_TTL_SECONDS=300
